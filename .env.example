# Complete Self System Environment Variables
# =============================================
# Copy this file to .env and fill in your values
# NEVER COMMIT .env TO VERSION CONTROL

# ============================================
# LLM PROVIDER CONFIGURATION
# ============================================

# AI_API_KEY - Your API key for the LLM provider
#   For OpenAI: sk-...
#   For OpenRouter: sk-or-...
#   For Groq: gsk_...
#   For Ollama: ollama (or leave empty)
#   For LM Studio: lmstudio (or leave empty)
AI_API_KEY=

# AI_BASE_URL - Base URL for the LLM API
#   OpenAI: https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Groq: https://api.groq.com/openai/v1
#   Mistral: https://api.mistral.ai/v1
#   Ollama (Local): http://localhost:11434/v1
#   LM Studio (Local): http://localhost:1234/v1
AI_BASE_URL=http://localhost:11434/v1

# AI_MODEL - Model to use for chat
#   OpenAI: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
#   OpenRouter: openai/gpt-4o-mini, anthropic/claude-3-sonnet
#   Groq: llama-3.1-70b-versatile, mixtral-8x7b-32768
#   Mistral: mistral-small-latest, mistral-medium-latest
#   Ollama: llama3.1, llama3, mistral, phi3
#   LM Studio: local-model
AI_MODEL=llama3.1

# AI_EMBEDDING_MODEL - Model to use for embeddings
#   OpenAI: text-embedding-3-small, text-embedding-3-large
#   OpenRouter: text-embedding-3-small, nomic-embed-text
#   Groq: nomic-embed-text
#   Ollama: nomic-embed-text, all-minilm
#   Mistral: mistral-embedding
AI_EMBEDDING_MODEL=nomic-embed-text

# AI_TIMEOUT - Timeout for API calls in seconds
AI_TIMEOUT=90

# AI_MAX_TOKENS - Maximum tokens for responses
AI_MAX_TOKENS=2000

# AI_TEMPERATURE - Temperature for generation (0.0 to 1.0)
AI_TEMPERATURE=0.2

# ============================================
# AGENT CONFIGURATION
# ============================================

# Enable agent mode (LLM can call tools)
AGENT_MODE=true

# Enable OpenAI-compatible tool calling
ENABLE_TOOL_CALLS=true

# Maximum number of tool calls per agent loop
MAX_AGENT_STEPS=8

# Number of conversation turns to include in context
CONTEXT_TURNS=12

# Maximum context characters
MAX_CONTEXT_CHARS=9000

# ============================================
# MEMORY CONFIGURATION
# ============================================

# Vector backend: sqlite, chroma, faiss, qdrant
VECTOR_BACKEND=sqlite

# Database path
DATABASE_PATH=storage/self_system.db

# Embedding dimension for fallback embeddings
EMBEDDING_DIM_FALLBACK=256

# Minimum similarity score for memory search
SIMILARITY_THRESHOLD=0.08

# Minimum score for direct knowledge answers
KNOWLEDGE_THRESHOLD=0.82

# ============================================
# SAFETY CONFIGURATION
# ============================================

# Enable autonomous mode (scheduled tasks run automatically)
AUTONOMOUS_MODE=false

# Auto-install generated skills (DANGEROUS - enable with caution)
AUTO_INSTALL_SKILLS=false

# Allow plugin tool execution
ALLOW_PLUGIN_TOOL=false

# Allow skill generation tool
ALLOW_SKILL_TOOL=false

# Enable voice output for responses
SPEAK_RESPONSES=false

# ============================================
# VOICE CONFIGURATION
# ============================================

# Enable voice features
VOICE_ENABLED=false

# Speech-to-text engine: google, sphinx, wit, ibm
VOICE_STT_ENGINE=google

# Text-to-speech engine: pyttsx3, espeak
VOICE_TTS_ENGINE=pyttsx3

# Language for speech
VOICE_LANGUAGE=en-US

# Speech rate (words per minute)
VOICE_RATE=150

# Volume level (0.0 to 1.0)
VOICE_VOLUME=0.9

# ============================================
# BROWSER CONFIGURATION
# ============================================

# Run browser in headless mode
BROWSER_HEADLESS=true

# Browser type: chromium, firefox, webkit
BROWSER_TYPE=chromium

# Timeout for browser operations in milliseconds
BROWSER_TIMEOUT_MS=30000

# ============================================
# SCHEDULER CONFIGURATION
# ============================================

# Enable scheduled tasks
SCHEDULER_ENABLED=true

# Path to scheduler database
SCHEDULER_DB_PATH=storage/scheduler.db

# ============================================
# STORAGE CONFIGURATION
# ============================================

# Base directory for storage
STORAGE_PATH=storage

# ============================================
# VECTOR STORAGE CONFIGURATION
# ============================================

# ChromaDB path
CHROMA_PATH=storage/vector/chroma

# ChromaDB collection name
CHROMA_COLLECTION=self_system_memory

# Qdrant server URL
QDRANT_URL=http://localhost:6333

# Qdrant collection name
QDRANT_COLLECTION=self_system

# FAISS index path
FAISS_PATH=storage/vector/faiss.index

# FAISS vector dimension
FAISS_DIMENSION=768

# ============================================
# LOGGING CONFIGURATION
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=storage/self_system.log

# Maximum log file size in bytes
LOG_MAX_SIZE=10485760

# Number of log files to keep
LOG_BACKUP_COUNT=5

# ============================================
# API SERVER CONFIGURATION (Future)
# ============================================

# Enable REST API
API_ENABLED=false

# API host
API_HOST=0.0.0.0

# API port
API_PORT=8000

# API prefix
API_PREFIX=/api/v1

# Enable CORS
CORS_ENABLED=true

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================
# DASHBOARD CONFIGURATION (Future)
# ============================================

# Enable web dashboard
DASHBOARD_ENABLED=false

# Dashboard host
DASHBOARD_HOST=0.0.0.0

# Dashboard port
DASHBOARD_PORT=8080

# Dashboard title
DASHBOARD_TITLE=Complete Self System

# ============================================
# NOTES
# ============================================
# 1. All variables are optional
# 2. Default values will be used if not set
# 3. For production, set all required values
# 4. NEVER commit .env to version control
# 5. .env is in .gitignore by default
# 6. Restart the application after changing configuration
# =============================================
