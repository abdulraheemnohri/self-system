# Complete Self System - Environment Configuration
# Copy this file to .env and configure your settings

# ============================================
# AI PROVIDER CONFIGURATION
# ============================================
# Configure your AI provider settings below
# Only one provider is active at a time

# --- Option 1: Ollama (Local) ---
# Run Ollama locally for free, open-source AI
# Installation: https://ollama.ai
PROVIDER_BASE_URL=http://localhost:11434/v1
PROVIDER_API_KEY=ollama
PROVIDER_MODEL=llama3.1

# Alternative Ollama models:
# PROVIDER_MODEL=llama3.2
# PROVIDER_MODEL=mistral
# PROVIDER_MODEL=phi3
# PROVIDER_MODEL=qwen2
# PROVIDER_MODEL=gemma2

# --- Option 2: OpenAI ---
# Uncomment and configure for OpenAI
# PROVIDER_BASE_URL=https://api.openai.com/v1
# PROVIDER_API_KEY=sk-your-openai-api-key-here
# PROVIDER_MODEL=gpt-4

# Alternative OpenAI models:
# PROVIDER_MODEL=gpt-4o
# PROVIDER_MODEL=gpt-4-turbo
# PROVIDER_MODEL=gpt-3.5-turbo

# --- Option 3: Anthropic (Claude) ---
# Uncomment and configure for Anthropic Claude
# PROVIDER_BASE_URL=https://api.anthropic.com/v1
# PROVIDER_API_KEY=sk-your-anthropic-api-key-here
# PROVIDER_MODEL=claude-3-5-sonnet-20241022

# Alternative Claude models:
# PROVIDER_MODEL=claude-3-haiku-20240307
# PROVIDER_MODEL=claude-3-sonnet-20240229
# PROVIDER_MODEL=claude-3-opus-20240229

# --- Option 4: Google (Gemini) ---
# Uncomment and configure for Google Gemini
# PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# PROVIDER_API_KEY=your-google-api-key-here
# PROVIDER_MODEL=gemini-1.5-pro

# Alternative Google models:
# PROVIDER_MODEL=gemini-1.5-flash
# PROVIDER_MODEL=gemini-pro
# PROVIDER_MODEL=gemini-pro-vision

# --- Option 5: OpenRouter ---
# Uncomment and configure for OpenRouter (multi-provider)
# Get API key from: https://openrouter.ai
# PROVIDER_BASE_URL=https://openrouter.ai/api/v1
# PROVIDER_API_KEY=sk-or-your-openrouter-api-key
# PROVIDER_MODEL=openai/gpt-4o

# OpenRouter supports many models:
# PROVIDER_MODEL=anthropic/claude-3-5-sonnet
# PROVIDER_MODEL=google/gemini-1.5-pro
# PROVIDER_MODEL=meta-llama/llama-3.1-70b
# PROVIDER_MODEL=mistralai/mistral-large

# --- Option 6: Mistral AI ---
# Uncomment and configure for Mistral
# PROVIDER_BASE_URL=https://api.mistral.ai/v1
# PROVIDER_API_KEY=your-mistral-api-key-here
# PROVIDER_MODEL=mistral-large

# Alternative Mistral models:
# PROVIDER_MODEL=mistral-small
# PROVIDER_MODEL=mistral-medium

# --- Option 7: Cohere ---
# Uncomment and configure for Cohere
# PROVIDER_BASE_URL=https://api.cohere.ai/v1
# PROVIDER_API_KEY=your-cohere-api-key-here
# PROVIDER_MODEL=command-r-plus

# Alternative Cohere models:
# PROVIDER_MODEL=command-r
# PROVIDER_MODEL=command

# --- Option 8: Groq ---
# Uncomment and configure for Groq (fast inference)
# PROVIDER_BASE_URL=https://api.groq.com/v1
# PROVIDER_API_KEY=your-groq-api-key-here
# PROVIDER_MODEL=llama-3.1-70b-versatile

# Alternative Groq models:
# PROVIDER_MODEL=llama-3.2-90b
# PROVIDER_MODEL=llama-3.2-11b
# PROVIDER_MODEL=mixtral-8x7b
# PROVIDER_MODEL=gemma2-9b

# ============================================
# PROVIDER SETTINGS
# ============================================

# Request timeout in seconds
PROVIDER_TIMEOUT=120

# Maximum number of retries for failed requests
PROVIDER_MAX_RETRIES=3

# Delay between retries in seconds
PROVIDER_RETRY_DELAY=1

# Use API embeddings (True) or local embeddings (False)
PROVIDER_USE_API_EMBEDDINGS=True

# Embedding model for API-based embeddings
PROVIDER_EMBEDDING_MODEL=text-embedding-3-small

# Alternative embedding models:
# PROVIDER_EMBEDDING_MODEL=text-embedding-3-large
# PROVIDER_EMBEDDING_MODEL=text-embedding-ada-002

# ============================================
# MEMORY & VECTOR STORE CONFIGURATION
# ============================================

# Vector backend: sqlite, chroma, qdrant
MEMORY_VECTOR_BACKEND=sqlite

# ChromaDB configuration (if using chroma backend)
MEMORY_CHROMA_PATH=storage/vector/chroma

# Qdrant configuration (if using qdrant backend)
MEMORY_QDRANT_URL=http://localhost:6333
MEMORY_QDRANT_COLLECTION=self_system

# ============================================
# DATABASE CONFIGURATION
# ============================================

# SQLite database path
DATABASE_PATH=storage/self_system.db

# ============================================
# TRANSLATION CONFIGURATION
# ============================================

# Translation API: libretranslate, google, local
TRANSLATION_API=libretranslate

# LibreTranslate API URL
TRANSLATION_API_URL=https://libretranslate.de/translate

# LibreTranslate API Key (if required)
TRANSLATION_API_KEY=

# ============================================
# SYSTEM CONFIGURATION
# ============================================

# Application name
APP_NAME=Complete Self System

# Application version
APP_VERSION=2.0.0

# Debug mode (True/False)
DEBUG=False

# Verbose logging (True/False)
VERBOSE=False

# Maximum history entries to keep
MAX_HISTORY_ENTRIES=1000

# History cleanup interval in days
HISTORY_CLEANUP_DAYS=30

# Storage directory
STORAGE_DIR=storage

# ============================================
# API SERVER CONFIGURATION
# ============================================

# Enable API server (True/False)
API_ENABLED=True

# API host (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
API_HOST=0.0.0.0

# API port
API_PORT=8000

# API authentication token (optional)
API_AUTH_TOKEN=

# CORS origins (comma-separated)
API_CORS_ORIGINS=*

# ============================================
# LOGGING CONFIGURATION
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/self_system.log

# Maximum log file size in bytes
LOG_MAX_SIZE=10485760

# Number of log files to keep
LOG_BACKUP_COUNT=5

# ============================================
# SECURITY CONFIGURATION
# ============================================

# Secret key for session management
SECRET_KEY=your-secret-key-here-change-this

# Enable rate limiting (True/False)
RATE_LIMIT_ENABLED=True

# Maximum requests per minute
RATE_LIMIT_REQUESTS=60

# ============================================
# DOCKER CONFIGURATION (if using Docker)
# ============================================

# Docker container name
DOCKER_CONTAINER_NAME=self-system

# Docker network
DOCKER_NETWORK=self-system-network

# ============================================
# EXAMPLE CONFIGURATIONS
# ============================================

# Example 1: Local development with Ollama
# PROVIDER_BASE_URL=http://localhost:11434/v1
# PROVIDER_API_KEY=ollama
# PROVIDER_MODEL=llama3.1
# DEBUG=True

# Example 2: Production with OpenAI
# PROVIDER_BASE_URL=https://api.openai.com/v1
# PROVIDER_API_KEY=sk-your-openai-key
# PROVIDER_MODEL=gpt-4
# DEBUG=False
# API_ENABLED=True

# Example 3: Termux on Android with local Ollama
# PROVIDER_BASE_URL=http://localhost:11434/v1
# PROVIDER_API_KEY=ollama
# PROVIDER_MODEL=llama3.1
# STORAGE_DIR=/data/data/com.termux/files/home/self-system/storage

# ============================================
# NOTES
# ============================================

# 1. Always keep your API keys secure
# 2. Never commit .env files to version control
# 3. For production, use environment variables or secret management
# 4. The .env file is in .gitignore by default
# 5. Restart the application after changing configuration

# ============================================
# TERMUX-SPECIFIC NOTES
# ============================================

# For Termux on Android:
# - Use PROVIDER_BASE_URL=http://localhost:11434/v1 for local Ollama
# - Ensure you have enough storage space
# - Use tmux for background execution
# - Check storage permissions with: termux-setup-storage

# ============================================
# SUPPORTED MODELS BY PROVIDER
# ============================================

# OpenAI: gpt-4, gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# Anthropic: claude-3-5-sonnet, claude-3-haiku, claude-3-sonnet, claude-3-opus
# Google: gemini-1.5-pro, gemini-1.5-flash, gemini-pro
# Mistral: mistral-large, mistral-small, mistral-medium
# Ollama: llama3.1, llama3.2, mistral, phi3, qwen2, gemma2
# Groq: llama-3.1-70b, llama-3.2-90b, mixtral-8x7b
# Cohere: command-r-plus, command-r, command
# OpenRouter: Any model from supported providers